NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Server-only (never NEXT_PUBLIC_): must match INTERNAL_API_KEY in backend/.env
INTERNAL_API_KEY=

# Cloud name from the Cloudinary dashboard. Set it when the backend uses CLOUDINARY_URL,
# so product images from Cloudinary are resized for each device.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
